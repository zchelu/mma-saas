{
  "_readme": "Canonical rank taxonomy for combat-sports member imports. Each discipline has a list of ranks in progression order. 'canonical' is the value the import script should normalize to; 'aliases' are real-world variants/misspellings an import script should fuzzy-match against (case-insensitive, whitespace-trimmed matching recommended before falling back to fuzzy string distance). 'stripes' lists valid stripe counts for that rank, or [] if the discipline doesn't use stripes.",

  "bjj_adult": {
    "label": "BJJ - Adult",
    "notes": "Standard adult IBJJF belt order. Stripes 0-4 per belt (4th stripe = eligible for promotion). Black belt stripes/degrees run further (1-6+) but 0-4 covers the common case.",
    "ranks": [
      {
        "canonical": "white",
        "order": 1,
        "stripes": [0, 1, 2, 3, 4],
        "aliases": ["white belt", "white", "wb", "whte", "whitebelt", "white-belt"]
      },
      {
        "canonical": "blue",
        "order": 2,
        "stripes": [0, 1, 2, 3, 4],
        "aliases": ["blue belt", "blue", "bb", "blu", "bluebelt", "blue-belt"]
      },
      {
        "canonical": "purple",
        "order": 3,
        "stripes": [0, 1, 2, 3, 4],
        "aliases": ["purple belt", "purple", "pb", "purpel", "purlpe", "purplebelt", "purple-belt"]
      },
      {
        "canonical": "brown",
        "order": 4,
        "stripes": [0, 1, 2, 3, 4],
        "aliases": ["brown belt", "brown", "brn", "broen", "brwon", "brownbelt", "brown-belt"]
