  "wrestling": {
    "label": "Wrestling",
    "notes": "No belt/rank system exists in wrestling. 'no_rank' is the expected, valid value for every wrestler - the import script should NOT flag this as an error or missing data.",
    "ranks": [
      { "canonical": "no_rank", "order": 0, "stripes": [], "aliases": ["no rank", "n/a", "na", "none", "no belt", "not applicable", "unranked", "no rank system", "-"] }
